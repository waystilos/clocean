{
  "name": "clocean",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "worker:dev": "wrangler dev --local --var ENVIRONMENT:development",
    "worker:deploy": "wrangler deploy",
    "deploy": "npm run build && wrangler deploy",
    "deploy:app": "npm run build && wrangler deploy",
    "ship": "npm run build && wrangler deploy",
    "deploy:one-click": "bash scripts/one-click-deploy.sh",
    "setup:r2": "bash scripts/setup-r2.sh",
    "login:local": "pulumi login --local",
    "infra:login:local": "pulumi login --local",
    "login:r2": "bash scripts/pulumi-r2-login.sh",
    "infra:login:r2": "bash scripts/pulumi-r2-login.sh",
    "preview": "vite preview",
    "test": "vitest run --fileParallelism=false",
    "test:unit": "vitest run --fileParallelism=false",
    "test:e2e": "npm run build && node scripts/run-cypress.js",
    "cypress:open": "cypress open",
    "cypress:run": "node scripts/run-cypress.js"
  },
  "packageManager": "pnpm@10.29.1",
  "dependencies": {
    "hono": "^4.7.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.23",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^16.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
