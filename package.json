{
  "name": "clocean",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy": "pnpm build && wrangler deploy",
    "setup:r2": "bash scripts/setup-r2.sh",
    "login:local": "pulumi login --local",
    "infra:login:local": "pulumi login --local",
    "login:r2": "bash scripts/pulumi-r2-login.sh",
    "infra:login:r2": "bash scripts/pulumi-r2-login.sh",
    "preview": "vite preview",
    "test": "vitest run --fileParallelism=false"
  },
  "packageManager": "pnpm@10.29.1",
  "dependencies": {
    "hono": "^4.7.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.23",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.1",
    "wrangler": "^3.111.0"
  }
}
