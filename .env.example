# =====================================================================
# Clocean — Environment Variables & Cloudflare Edge Secrets
# =====================================================================
# Copy this file to .dev.vars for local development:
#   cp .env.example .dev.vars
#
# For production secrets, use Wrangler CLI:
#   npx wrangler secret put CF_ACCESS_AUD
#   npx wrangler secret put RESEND_API_KEY
# =====================================================================

# Environment Mode: "development" | "production"
# In production, Cloudflare Zero Trust JWT authentication is strictly enforced.
ENVIRONMENT="development"

# Cloudflare Zero Trust Application Audience Tag (AUD)
# Found in: Cloudflare Zero Trust Dashboard > Access > Applications > View Key
# Required in production to cryptographically verify Access JWT headers.
CF_ACCESS_AUD=""

# Allowed CORS & WebSocket Origin Hosts (comma-separated)
# In production, set to your custom domain (e.g. "https://clocean.yourcompany.com")
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ---------------------------------------------------------------------
# Optional: Transactional Email Notifications (@mentions & invites)
# ---------------------------------------------------------------------
# Option A: Cloudflare Email Routing (Native send_email binding in wrangler.jsonc)
# Option B: Resend API Key (https://resend.com)
RESEND_API_KEY=""

# Sender email address for notifications
EMAIL_FROM="notifications@clocean.co"
